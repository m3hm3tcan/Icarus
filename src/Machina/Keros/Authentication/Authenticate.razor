@using Microsoft.AspNetCore.Components.WebAssembly.Authentication

@page "/auth/{action}"

@inject NavigationManager Navigation
@inject RedirectStack Redirects

<RemoteAuthenticatorView Action="@Action" OnLogInSucceeded="@OnLoginSucceeded" />

@code {
    /// <summary>
    /// Gets or sets the action to perform.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }

    /// <summary>
    /// Handles the event when the user logs in successfully.
    /// </summary>
    private void OnLoginSucceeded()
    {
        if (!Redirects.TryRestore(out var returnUrl))
        {
            returnUrl = "/";
        }
        Navigation.NavigateTo(returnUrl, forceLoad: true, replace: true);
    }
}
