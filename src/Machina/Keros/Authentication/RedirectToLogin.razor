@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        var query = Uri.TryCreate(Navigation.Uri, UriKind.RelativeOrAbsolute, out var result) switch
        {
            true => $"?returnUrl={result.AbsolutePath}",
            false => null
        };

        Navigation.NavigateTo("/auth/login" + query);
    }
}