@inject IServiceProvider ServiceProvider
@inject NavigationManager Navigation

@page "/login"

<PageTitle>Login</PageTitle>

<h1>Log in</h1>

@foreach (var provider in ServiceProvider.GetServices<ILoginProvider>())
{
    <FluentButton Appearance="Appearance.Lightweight" @onclick="@(e => Redirect(provider))">@provider.Name</FluentButton>
}

@code {
    /// <summary>
    /// Performs login operation on requested login provider.
    /// </summary>
    /// <param name="provider">The <see cref="ILoggerProvider"/> to use for the login process.</param>
    private void Redirect(ILoginProvider provider)
    {
        Navigation.NavigateTo("/auth/login");
    }
}
